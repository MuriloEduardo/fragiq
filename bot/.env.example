# Conta Steam DEDICADA ao bot. Nunca use conta pessoal: ela ficará amiga de
# desconhecidos e um comprometimento levaria junto inventário e trades.
STEAM_BOT_ACCOUNT=""

# Só no primeiro login. O steam-user vai imprimir um refresh token — guarde
# em STEAM_BOT_REFRESH_TOKEN, apague a senha daqui e nunca mais precise do
# Steam Guard.
STEAM_BOT_PASSWORD=""
STEAM_BOT_REFRESH_TOKEN=""

# Em produção os valores sensíveis (STEAM_BOT_REFRESH_TOKEN,
# FRAGIQ_WEBHOOK_SECRET) vêm do AWS Secrets Manager: defina o nome do segredo
# aqui e deixe as variáveis acima vazias. Sem isto, vale o que está neste
# arquivo — é o caminho de desenvolvimento.
FRAGIQ_SECRET_ID=""

# Endpoint da aplicação e o segredo que ele espera (BOT_WEBHOOK_SECRET lá).
FRAGIQ_WEBHOOK_URL="https://fragiq-rouge.vercel.app/api/sync/steam-event"
FRAGIQ_WEBHOOK_SECRET=""

# Espera entre a pessoa sair do jogo e o aviso. A Steam demora a gravar as
# estatísticas; avisar cedo demais coleta números velhos.
BOT_GRACE_MS="90000"

# Aceitar pedidos de amizade automaticamente.
BOT_AUTO_ACCEPT="true"
