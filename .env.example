# Postgres local (docker compose up -d). Porta 5433 para não colidir com um
# Postgres já instalado na máquina.
DATABASE_URL="postgresql://fragiq:fragiq@localhost:5433/fragiq?schema=public"

# Chave da Steam Web API: https://steamcommunity.com/dev/apikey
# Usada para ler perfil, biblioteca e estatísticas. Nunca vai ao browser.
STEAM_API_KEY=""

# Segredo de assinatura da sessão (HS256). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# URL pública da app — usada para montar o return_to do OpenID da Steam.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protege /api/cron/sync. Na Vercel, defina o mesmo valor nas env vars.
CRON_SECRET=""

# Quanto tempo o cron pode gastar por execução. 45s cabe no limite de 60s
# do plano Hobby da Vercel; no Pro dá para subir junto com o maxDuration.
CRON_TIME_BUDGET_MS="45000"
