# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Local: docker compose up -d (porta 5433 para não colidir com um Postgres
# já instalado na máquina).
DATABASE_URL="postgresql://fragiq:fragiq@localhost:5433/fragiq?schema=public"

# Só em produção com provedor serverless (Neon, Supabase, Vercel Postgres):
# a URL sem pooler, usada pelas migrations. Migration por pooler trava.
# Em local, deixe vazio.
DIRECT_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Steam
# ---------------------------------------------------------------------------
# https://steamcommunity.com/dev/apikey — lê perfil, biblioteca e estatísticas.
# Nunca vai ao browser.
STEAM_API_KEY=""

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Assinatura do cookie de sessão (HS256). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desloga todo mundo.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# URL pública
# ---------------------------------------------------------------------------
# Opcional. Só preencha para domínio próprio; na Vercel a URL do projeto é
# detectada sozinha via VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=""

# ---------------------------------------------------------------------------
# Coleta agendada
# ---------------------------------------------------------------------------
# Protege /api/cron/sync. A Vercel envia este valor como Bearer nos cron jobs
# automaticamente quando a variável tem exatamente este nome.
CRON_SECRET=""

# Orçamento por execução do cron. 45s cabe no limite de 60s do plano Hobby;
# no Pro dá para subir junto com o maxDuration.
CRON_TIME_BUDGET_MS="45000"

# Segredo compartilhado com o bot de presença (bot/).
BOT_WEBHOOK_SECRET=""
# SteamID64 da conta do bot, para o cartão "adicione o bot" mostrar a conta
# certa e conferir se ela já é sua amiga.
BOT_STEAM_ID="76561198647798293"

# ---------------------------------------------------------------------------
# Analista (cogniflow)
# ---------------------------------------------------------------------------
# O FragIQ é um tenant do cogniflow: a pergunta vai por webhook e a resposta
# volta por callback. As três são opcionais — sem elas a seção "Pergunte ao
# analista" não aparece. Ver docs/cogniflow-tenant.md.
COGNIFLOW_WEBHOOK_URL=""
COGNIFLOW_CLIENT_ID="fragiq"
# Mesmo valor de tenants.fragiq.webhook.web.WEBHOOK_SIGNING_SECRET no
# segredo de plataforma do cogniflow. Assina os dois sentidos.
COGNIFLOW_SIGNING_SECRET=""

# ---------------------------------------------------------------------------
# Painel administrativo
# ---------------------------------------------------------------------------
# SteamIDs (64 bits) separados por vírgula que podem abrir /admin. Vazio =
# ninguém.
ADMIN_STEAM_IDS=""
