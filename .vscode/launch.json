{
  "version": "0.2.0",
  "configurations": [
    {
      // Único launcher: sobe o Postgres, roda o Next e abre o Chrome já
      // anexado. No App Router não existem processos separados de front e
      // back — as rotas de API, os Server Components e o sync da Steam são
      // o mesmo processo — então "full stack" aqui é um alvo só, e os
      // breakpoints valem dos dois lados.
      "name": "FragIQ",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "db",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    }
  ]
}
