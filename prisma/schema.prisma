// FragIQ — schema.
// Modelo central: séries temporais de estatísticas por (usuário, jogo).
// Os contadores da Steam Web API são cumulativos e vitalícios; guardamos
// snapshots periódicos e derivamos a performance de um período pelo delta
// entre dois snapshots. Isso é o que permite "acompanhar ao longo do tempo".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // SteamID64 — identificador externo estável. O personaName muda, este não.
  steamId     String  @unique
  personaName String
  avatarUrl   String?
  profileUrl  String?
  countryCode String?

  /// A página pública em /p/<steamId>. Mostra só o que a Steam já mostra a
  /// qualquer um; a curva e as leituras nunca saem daqui. Desligar esconde a
  /// página inteira.
  perfilPublico Boolean @default(true)

  /// Receber a análise de cada sessão no chat da Steam, pelo bot. Só chega
  /// para quem adicionou o bot; desligar aqui silencia mesmo sendo amigo.
  avisoSteam         Boolean   @default(true)
  /// O último lembrete, no chat, de que a Steam não deixa ler as
  /// estatísticas ("Detalhes do jogo" privado), e quantos já foram. O bot
  /// insiste de tempos em tempos (`lembrarPendenciasNoSteam`), com teto.
  avisoPrivacidadeEm DateTime?
  avisosPrivacidade  Int       @default(0)
  /// O último lembrete de que a corrente de share codes está desligada —
  /// sem ela não há partida oficial nem modo por partida — e quantos já
  /// foram. Mesma cadência e mesmo teto.
  avisoPartidasEm    DateTime?
  avisosPartidas     Int       @default(0)
  /// Desde quando o bot de presença é amigo (o bot reporta a lista). null =
  /// não é. É o que o funil de ativação lê sem perguntar à Steam.
  botAmigoDesde      DateTime?

  /// Código de autenticação do histórico de partidas (a Steam chama de
  /// "match history authentication code"). Só serve para pedir o próximo
  /// share code à Web API — não abre inventário, chat nem nada da conta.
  /// Guardado cifrado; a pessoa revoga na página de segurança ou gerando
  /// outro na Steam.
  steamAuthCode      String?
  /// O share code mais recente que conhecemos: é de onde a próxima busca
  /// continua. A Steam só responde "qual é o seguinte a este".
  shareCodeAtual     String?
  /// Último erro ao falar com a Steam sobre partidas, para a página dizer
  /// o que fazer (código inválido, share code expirado...).
  partidasErro       String?
  partidasAtivadasEm DateTime?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  partidas    MatchPlayer[]
  sessoes     Session[]
  captura     PendingCapture?
  games       UserGame[]
  syncRuns    SyncRun[]
  feedback    Feedback[]
  analyses    Analysis[]
  participant Participant?
  seguindo    Follow[]        @relation("seguidor")
  seguidores  Follow[]        @relation("seguido")
  mensagens   SteamMessage[]

  @@map("users")
}

model Game {
  // appId da Steam (730 = CS2). Chave natural, usada nas URLs.
  appId Int    @id
  name  String

  iconHash String?

  // Schema de stats vindo de ISteamUserStats/GetSchemaForGame: mapeia
  // nomes crus ("total_kills") para rótulos legíveis. Cacheado por jogo,
  // não por usuário.
  statSchema      Json?
  schemaFetchedAt DateTime?

  // false quando o jogo não expõe stats públicas — evita refetch a cada sync.
  supportsStats Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players UserGame[]

  @@map("games")
}

model UserGame {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int
  game      Game @relation(fields: [gameAppId], references: [appId], onDelete: Cascade)

  playtimeForeverMin  Int       @default(0)
  playtimeTwoWeeksMin Int       @default(0)
  lastPlayedAt        DateTime?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots StatSnapshot[]

  @@unique([userId, gameAppId])
  @@index([userId, playtimeForeverMin])
  @@map("user_games")
}

model StatSnapshot {
  id String @id @default(cuid())

  userGameId String
  userGame   UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  // Tempo de jogo no instante do snapshot — permite normalizar deltas por hora.
  playtimeForeverMin Int @default(0)

  // Stats cruas do jogo: { "total_kills": 41234, "total_deaths": 39001, ... }
  // Json porque cada appId tem um conjunto de stats totalmente diferente.
  metrics Json

  achievementsUnlocked Int?
  achievementsTotal    Int?

  /// Contexto da partida que produziu o delta até este snapshot, quando o bot
  /// de presença conseguiu observá-la.
  ///
  /// A API de estatísticas não distingue modo nem cobre os mapas modernos,
  /// mas o rich presence do CS2 publica os dois para amigos. Guardando aqui,
  /// o delta entre o snapshot anterior e este passa a ser atribuível a um
  /// mapa e a um modo — o que a Web API sozinha não permite.
  matchMap   String?
  matchMode  String?
  matchScore String?

  /// Proveniência: a coleta que criou este ponto, o gatilho dela e o
  /// `traceId` que amarra bot → captura → coleta → ponto. Nulo no histórico
  /// anterior a 2026-09-16 (docs/dados-confiaveis.md §3.1).
  syncRunId String?
  syncRun   SyncRun?     @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  trigger   SyncTrigger?
  traceId   String?

  analyses Analysis[]

  @@unique([userGameId, capturedAt])
  @@index([userGameId, capturedAt])
  @@index([userGameId, matchMode])
  @@index([traceId])
  @@map("stat_snapshots")
}

/// Feedback do beta. Só de usuário autenticado, então cada mensagem já vem
/// amarrada ao SteamID — dá para ler o relato e olhar a série da pessoa lado
/// a lado, que é o que torna o feedback acionável.
model Feedback {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String

  /// De onde a pessoa enviou. "Está confuso" significa coisas diferentes no
  /// dashboard e no explorador.
  path String?

  /// A pessoa escolheu que este relato apareça na página da comunidade, com
  /// o nome dela. Padrão privado: feedback é confissão até se dizer o
  /// contrário.
  publico Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}

/// Uma linha por invocação do coletor agendado, mesmo quando não há nada a
/// fazer.
///
/// O SyncRun é por usuário e só nasce dentro de syncUser — então uma execução
/// que não encontra candidatos não deixa rastro nenhum. Isso torna
/// indistinguível "o agendador não disparou" de "disparou e não havia o que
/// coletar", e a diferença importa: dado perdido por cron parado não é
/// recuperável, porque a Steam só sabe o total de hoje.
model CronRun {
  id String @id @default(cuid())

  status SyncStatus @default(RUNNING)

  candidates Int @default(0)
  synced     Int @default(0)
  failed     Int @default(0)
  skipped    Int @default(0)
  snapshots  Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@map("cron_runs")
}

model SyncRun {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger     SyncTrigger @default(MANUAL)
  status      SyncStatus  @default(RUNNING)
  gamesSeen   Int         @default(0)
  gamesStored Int         @default(0)
  error       String?
  /// Vem do bot (evento) ou nasce aqui (cron, manual, login). É o fio da auditoria.
  traceId     String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  snapshots StatSnapshot[]

  @@index([userId, startedAt])
  @@index([traceId])
  @@map("sync_runs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// De onde partiu a coleta. Útil para saber se a série de um usuário vem do
/// cron (contínua) ou só de cliques manuais (esburacada).
enum SyncTrigger {
  MANUAL
  LOGIN
  CRON
  /// Disparado pelo bot de presença quando o jogador sai de uma partida.
  EVENT
}

/// Uma pergunta feita ao analista sobre um jogo, e a resposta quando chega.
///
/// O analista é um agente do cogniflow, e a conversa com ele é assíncrona:
/// a pergunta sai por webhook, a resposta volta por callback segundos
/// depois. A linha existe para que a tela tenha o que mostrar nesse meio
/// tempo e para que a resposta tenha onde pousar quando o request que
/// perguntou já acabou.
model Analysis {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int

  question String
  answer   String?

  /// Uma análise chega sozinha a cada sessão nova (SESSION) ou porque a
  /// pessoa perguntou (QUESTION). A primeira é o produto; a segunda, o
  /// acompanhamento.
  kind AnalysisKind @default(QUESTION)

  /// A coleta que fechou a sessão analisada. Única: uma sessão, uma análise —
  /// é o que impede o cron, o bot e a página de pedirem a mesma três vezes.
  snapshotId String?       @unique
  snapshot   StatSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  status AnalysisStatus @default(PENDING)
  error  String?

  /// ID da resposta no cogniflow. É determinístico por turno: uma entrega
  /// repetida chega com o mesmo ID, e é assim que a repetição é descartada.
  replyId String? @unique

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  answeredAt     DateTime?

  @@index([userId, gameAppId, createdAt])
  @@map("analyses")
}

enum AnalysisKind {
  SESSION
  QUESTION
}

enum AnalysisStatus {
  /// Enviada ao cogniflow; nenhuma confirmação ainda.
  PENDING
  /// O cogniflow confirmou o recebimento e está respondendo.
  ACKNOWLEDGED
  ANSWERED
  FAILED
}

/// Quem escolheu fazer parte do desenvolvimento.
///
/// Uma linha por usuário. Existir aqui é o que dá o selo de beta tester; o
/// GitHub é para quem quer código, e a mensagem é o que a pessoa disse que
/// quer fazer. `visivel` decide se aparece na lista pública.
model Participant {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubLogin String?
  /// O que a pessoa se dispôs a fazer: testar, desenvolver, trazer dados…
  papeis      String[]
  mensagem    String?

  visivel Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("participants")
}

/// Ver a curva de outra pessoa exige que ela deixe.
///
/// Os números vitalícios são públicos na Steam; a série de coletas, as
/// sessões e as leituras não são públicas em lugar nenhum. Então "seguir" é
/// um pedido: fica PENDING até quem é seguido aceitar, e só a partir daí a
/// página pública dessa pessoa mostra a curva para quem pediu.
model Follow {
  id String @id @default(cuid())

  seguidorId String
  seguidor   User   @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)

  seguidoId String
  seguido   User   @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  status FollowStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  decididoEm DateTime?

  @@unique([seguidorId, seguidoId])
  @@index([seguidoId, status])
  @@map("follows")
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

/// Uma mensagem para o bot entregar no chat da Steam.
///
/// O bot não recebe chamadas: ele mora numa EC2 sem porta aberta e só faz
/// saída. Então o site enfileira aqui e o bot busca de tempos em tempos,
/// entrega e marca. Uma linha por mensagem, com o resultado da entrega —
/// é o que permite ver no painel o que chegou e o que não chegou.
model SteamMessage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  steamId String
  texto   String

  status SteamMessageStatus @default(PENDING)
  error  String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("steam_messages")
}

enum SteamMessageStatus {
  PENDING
  SENT
  FAILED
}

/// Uma partida oficial de matchmaking, como o Game Coordinator do CS2 a
/// descreve para quem tem o share code: placar final, duração, e a linha de
/// scoreboard de cada um dos dez jogadores. É o que a Web API não dá —
/// por partida, não por total — e o que o csstats tem.
model Match {
  /// O matchid do GC (uint64), como string.
  id        String @id
  shareCode String @unique

  status     MatchStatus @default(PENDING)
  /// Quantas vezes o bot já pediu ao GC. Depois de algumas, desiste.
  tentativas Int         @default(0)
  error      String?

  jogadaEm DateTime?
  duracaoS Int?
  rounds   Int?
  /// Mapa lido do cabeçalho da demo (o GC não diz); reserva é o bot de
  /// presença de quem estava na partida.
  mapa     String?
  /// Nome do servidor da Valve, do mesmo cabeçalho ("south_america … gru1").
  servidor String?
  gameType Int?
  /// O modo da partida (premier, competitive, scrimcomp2v2…), resolvido na
  /// gravação: pelo `gameType` do GC quando o valor é conhecido, senão pelo
  /// rich presence de quem estava nela. É o eixo do submenu de modos.
  modo     String?
  placarA  Int?
  placarB  Int?
  demoUrl  String?

  /// Quem tinha a corrente de share codes que revelou esta partida. Os
  /// outros nove jogadores a ganham de graça.
  descobertaPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jogadores MatchPlayer[]

  @@index([status, createdAt])
  @@index([jogadaEm])
  @@index([modo])
  @@map("matches")
}

enum MatchStatus {
  /// Conhecemos o share code; o bot ainda não pediu ao GC.
  PENDING
  /// Scoreboard gravado.
  DONE
  /// O GC não tem mais a partida (guarda ~30 dias).
  EXPIRED
  /// Desistimos depois de várias tentativas.
  FAILED
}

/// A linha de um jogador no scoreboard de uma partida. Existe para os dez,
/// tenham conta aqui ou não: é o que permite comparar, ver amigos na mesma
/// partida e mostrar a página pública.
model MatchPlayer {
  id String @id @default(cuid())

  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  steamId String
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// 0 = os cinco primeiros da reserva (placarA), 1 = os cinco últimos (placarB).
  time    Int
  kills   Int
  assists Int
  deaths  Int
  mvps    Int
  score   Int
  hs      Int
  /// null em empate.
  venceu  Boolean?

  @@unique([matchId, steamId])
  @@index([steamId])
  @@index([userId])
  @@map("match_players")
}

/// Uma coleta que o bot pediu e ainda não deu certo.
///
/// O bot é um sensor: vê o fim da partida, avisa, e esquece. Quem lembra
/// é esta tabela — o contexto observado, quantas vezes já tentamos e
/// quando é a próxima. Reiniciar o bot não perde nada, e o cron pode
/// retomar o que a Steam demorou. Uma por pessoa: uma partida nova
/// substitui a anterior (o delta cobre as duas).
model PendingCapture {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  steamId String

  matchMap   String?
  matchMode  String?
  matchScore String?
  traceId    String?

  tentativa Int      @default(0)
  proximaEm DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proximaEm])
  @@map("pending_captures")
}

/// O bot conta como está a cada tick. Uma linha só.
model BotStatus {
  id           String    @id @default("bot")
  ultimoTickEm DateTime
  amigos       Int       @default(0)
  gcConectado  Boolean   @default(false)
  iniciadoEm   DateTime?
  /// O bot bate mesmo sem sessão na Steam: "parado" e "deslogado" são coisas diferentes.
  logado            Boolean   @default(true)
  desconectadoDesde DateTime?
  motivo            String?

  @@map("bot_status")
}

/// O que aconteceu de notável — erros e transições que o painel lista.
///
/// Não é analytics de clique: é o diário de operação. Um `catch` que só
/// escrevia no log da Vercel passa a deixar uma linha aqui, com quem e o
/// quê, para o painel mostrar sem ninguém abrir log.
model Evento {
  id String @id @default(cuid())

  nome    String
  userId  String?
  dados   Json?
  traceId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([nome, createdAt])
  @@map("eventos")
}

/// Uma sessão, materializada: o intervalo entre duas coletas em que os
/// rounds subiram, fechado no momento em que a segunda coleta é gravada.
///
/// Antes disso a sessão era recalculada a cada request sobre o balde de
/// snapshots, e o modo era o da coleta que fechava o intervalo — sem prova
/// de que o intervalo tinha uma partida só. Aqui os deltas são fatos
/// derivados uma vez, e o modo vem de `atribuirModo` (docs/dados-confiaveis.md
/// §3.2) com a confiança ao lado. `regraVersao` diz sob qual regra; mudou a
/// regra, `recompute:sessions` refaz.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameAppId  Int
  userGameId String

  deSnapshotId  String
  /// Uma sessão por coleta que a fecha: é a chave da idempotência.
  ateSnapshotId String @unique
  de            DateTime
  ate           DateTime

  /// Deltas do intervalo. `minutos` é o tempo EM PARTIDA quando a Steam dá
  /// `total_time_played`, senão o playtime.
  minutos   Int
  rounds    Int
  partidas  Int?
  vitorias  Int?
  kills     Int?
  deaths    Int?
  headshots Int?
  dano      Int?
  mvps      Int?

  modo          String?
  modoConfianca ModoConfianca
  mapa          String?
  placar        String?
  /// As provas usadas: partidas do GC e observações do bot dentro do intervalo.
  matchIds      String[] @default([])
  observacaoIds String[] @default([])

  regraVersao Int
  traceId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, gameAppId, ate])
  @@index([userId, gameAppId, modo, modoConfianca])
  @@index([userGameId, ate])
  @@map("sessions")
}

enum ModoConfianca {
  /// Uma partida no intervalo e uma prova dela (GC ou bot).
  EXATA
  /// Várias partidas, todas provadas do mesmo modo — ou marca do bot antigo.
  INFERIDA
  /// Sem prova suficiente. Nunca entra numa aba nem num normal de modo.
  MISTA
}

/// O que o bot de presença viu, antes de qualquer coleta.
///
/// A captura pendente some quando vira ponto; a observação fica. É o único
/// registro de "houve uma partida de Premier em Mirage às 22:02", e é o que
/// permite dar modo a uma sessão com prova, não por proximidade
/// (docs/dados-confiaveis.md §3.1–3.2).
model BotObservation {
  id String @id @default(cuid())

  steamId String
  /// Nulo quando o bot é amigo de alguém que ainda não entrou no site.
  userId  String?

  kind       BotObservationKind
  map        String?
  mode       String?
  score      String?
  observedAt DateTime
  traceId    String

  createdAt DateTime @default(now())

  @@index([steamId, observedAt])
  @@index([userId, observedAt])
  @@index([traceId])
  @@map("bot_observations")
}

enum BotObservationKind {
  /// Rich presence perdeu o mapa: voltou ao lobby.
  MATCH_ENDED
  /// Fechou o CS2.
  LEFT_GAME
}

/// O log do bot, no banco, para o painel ler sem SSH.
///
/// O bot envia lotes (`POST /api/bot/logs`); a rota apaga o que tem mais
/// de 30 dias. Nível, mensagem e, quando o bot sabe, de quem e de qual
/// trace se trata.
model BotLog {
  id String @id @default(cuid())

  nivel    BotLogLevel
  mensagem String
  dados    Json?
  steamId  String?
  traceId  String?
  /// Quando o bot escreveu (o `createdAt` é quando chegou).
  em       DateTime

  createdAt DateTime @default(now())

  @@index([em])
  @@index([nivel, em])
  @@index([traceId])
  @@map("bot_logs")
}

enum BotLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}
