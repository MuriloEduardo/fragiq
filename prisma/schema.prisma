// FragIQ — schema.
// Modelo central: séries temporais de estatísticas por (usuário, jogo).
// Os contadores da Steam Web API são cumulativos e vitalícios; guardamos
// snapshots periódicos e derivamos a performance de um período pelo delta
// entre dois snapshots. Isso é o que permite "acompanhar ao longo do tempo".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // SteamID64 — identificador externo estável. O personaName muda, este não.
  steamId     String  @unique
  personaName String
  avatarUrl   String?
  profileUrl  String?
  countryCode String?

  /// A página pública em /p/<steamId>. Mostra só o que a Steam já mostra a
  /// qualquer um; a curva e as leituras nunca saem daqui. Desligar esconde a
  /// página inteira.
  perfilPublico Boolean @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  games       UserGame[]
  syncRuns    SyncRun[]
  feedback    Feedback[]
  analyses    Analysis[]
  participant Participant?

  @@map("users")
}

model Game {
  // appId da Steam (730 = CS2). Chave natural, usada nas URLs.
  appId Int    @id
  name  String

  iconHash String?

  // Schema de stats vindo de ISteamUserStats/GetSchemaForGame: mapeia
  // nomes crus ("total_kills") para rótulos legíveis. Cacheado por jogo,
  // não por usuário.
  statSchema      Json?
  schemaFetchedAt DateTime?

  // false quando o jogo não expõe stats públicas — evita refetch a cada sync.
  supportsStats Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players UserGame[]

  @@map("games")
}

model UserGame {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int
  game      Game @relation(fields: [gameAppId], references: [appId], onDelete: Cascade)

  playtimeForeverMin  Int       @default(0)
  playtimeTwoWeeksMin Int       @default(0)
  lastPlayedAt        DateTime?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots StatSnapshot[]

  @@unique([userId, gameAppId])
  @@index([userId, playtimeForeverMin])
  @@map("user_games")
}

model StatSnapshot {
  id String @id @default(cuid())

  userGameId String
  userGame   UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  capturedAt DateTime @default(now())

  // Tempo de jogo no instante do snapshot — permite normalizar deltas por hora.
  playtimeForeverMin Int @default(0)

  // Stats cruas do jogo: { "total_kills": 41234, "total_deaths": 39001, ... }
  // Json porque cada appId tem um conjunto de stats totalmente diferente.
  metrics Json

  achievementsUnlocked Int?
  achievementsTotal    Int?

  /// Contexto da partida que produziu o delta até este snapshot, quando o bot
  /// de presença conseguiu observá-la.
  ///
  /// A API de estatísticas não distingue modo nem cobre os mapas modernos,
  /// mas o rich presence do CS2 publica os dois para amigos. Guardando aqui,
  /// o delta entre o snapshot anterior e este passa a ser atribuível a um
  /// mapa e a um modo — o que a Web API sozinha não permite.
  matchMap   String?
  matchMode  String?
  matchScore String?

  analyses Analysis[]

  @@unique([userGameId, capturedAt])
  @@index([userGameId, capturedAt])
  @@index([userGameId, matchMode])
  @@map("stat_snapshots")
}

/// Feedback do beta. Só de usuário autenticado, então cada mensagem já vem
/// amarrada ao SteamID — dá para ler o relato e olhar a série da pessoa lado
/// a lado, que é o que torna o feedback acionável.
model Feedback {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String

  /// De onde a pessoa enviou. "Está confuso" significa coisas diferentes no
  /// dashboard e no explorador.
  path String?

  /// A pessoa escolheu que este relato apareça na página da comunidade, com
  /// o nome dela. Padrão privado: feedback é confissão até se dizer o
  /// contrário.
  publico Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback")
}

/// Uma linha por invocação do coletor agendado, mesmo quando não há nada a
/// fazer.
///
/// O SyncRun é por usuário e só nasce dentro de syncUser — então uma execução
/// que não encontra candidatos não deixa rastro nenhum. Isso torna
/// indistinguível "o agendador não disparou" de "disparou e não havia o que
/// coletar", e a diferença importa: dado perdido por cron parado não é
/// recuperável, porque a Steam só sabe o total de hoje.
model CronRun {
  id String @id @default(cuid())

  status SyncStatus @default(RUNNING)

  candidates Int @default(0)
  synced     Int @default(0)
  failed     Int @default(0)
  skipped    Int @default(0)
  snapshots  Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@map("cron_runs")
}

model SyncRun {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger     SyncTrigger @default(MANUAL)
  status      SyncStatus  @default(RUNNING)
  gamesSeen   Int         @default(0)
  gamesStored Int         @default(0)
  error       String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, startedAt])
  @@map("sync_runs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// De onde partiu a coleta. Útil para saber se a série de um usuário vem do
/// cron (contínua) ou só de cliques manuais (esburacada).
enum SyncTrigger {
  MANUAL
  LOGIN
  CRON
  /// Disparado pelo bot de presença quando o jogador sai de uma partida.
  EVENT
}

/// Uma pergunta feita ao analista sobre um jogo, e a resposta quando chega.
///
/// O analista é um agente do cogniflow, e a conversa com ele é assíncrona:
/// a pergunta sai por webhook, a resposta volta por callback segundos
/// depois. A linha existe para que a tela tenha o que mostrar nesse meio
/// tempo e para que a resposta tenha onde pousar quando o request que
/// perguntou já acabou.
model Analysis {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameAppId Int

  question String
  answer   String?

  /// Uma análise chega sozinha a cada sessão nova (SESSION) ou porque a
  /// pessoa perguntou (QUESTION). A primeira é o produto; a segunda, o
  /// acompanhamento.
  kind AnalysisKind @default(QUESTION)

  /// A coleta que fechou a sessão analisada. Única: uma sessão, uma análise —
  /// é o que impede o cron, o bot e a página de pedirem a mesma três vezes.
  snapshotId String?       @unique
  snapshot   StatSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  status AnalysisStatus @default(PENDING)
  error  String?

  /// ID da resposta no cogniflow. É determinístico por turno: uma entrega
  /// repetida chega com o mesmo ID, e é assim que a repetição é descartada.
  replyId String? @unique

  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  answeredAt     DateTime?

  @@index([userId, gameAppId, createdAt])
  @@map("analyses")
}

enum AnalysisKind {
  SESSION
  QUESTION
}

enum AnalysisStatus {
  /// Enviada ao cogniflow; nenhuma confirmação ainda.
  PENDING
  /// O cogniflow confirmou o recebimento e está respondendo.
  ACKNOWLEDGED
  ANSWERED
  FAILED
}

/// Quem escolheu fazer parte do desenvolvimento.
///
/// Uma linha por usuário. Existir aqui é o que dá o selo de beta tester; o
/// GitHub é para quem quer código, e a mensagem é o que a pessoa disse que
/// quer fazer. `visivel` decide se aparece na lista pública.
model Participant {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubLogin String?
  /// O que a pessoa se dispôs a fazer: testar, desenvolver, trazer dados…
  papeis      String[]
  mensagem    String?

  visivel Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("participants")
}
